<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Catálogo - CineVintage</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <nav class="vintage-nav">
    <div class="nav-wrapper container">
      <a href="/" class="brand-logo">🎬 CineVintage</a>
      <ul class="right hide-on-med-and-down">
        <li><a href="/">Inicio</a></li>
        <li><a href="/movies">Catálogo</a></li>
        <li><a href="/contact">Contacto</a></li>
        <li><a href="/admin">Mensajes</a></li>
        <li><a href="/about">Acerca de</a></li>
      </ul>
    </div>
  </nav>

  <div class="container" style="margin-top: 30px;">
    <!-- Formulario con 5 Campos Obligatorios -->
    <div class="vintage-card">
      <h4>Agregar Nueva Película / Serie</h4>
      <form action="/movies" method="POST">
        <div class="row">
          <div class="input-field col s12 m6">
            <input id="titulo" type="text" name="titulo" required>
            <label for="titulo">1. Título</label>
          </div>
          <div class="input-field col s12 m6">
            <input id="tipo" type="text" name="tipo" placeholder="Película o Serie" required>
            <label for="tipo" class="active">2. Tipo</label>
          </div>
        </div>
        <div class="row">
          <div class="input-field col s12 m4">
            <input id="genero" type="text" name="genero" required>
            <label for="genero">3. Género</label>
          </div>
          <div class="input-field col s12 m4">
            <input id="anio" type="number" name="anio" required>
            <label for="anio">4. Año de Estreno</label>
          </div>
          <div class="input-field col s12 m4">
            <input id="calificacion" type="number" step="0.1" min="0" max="10" name="calificacion" required>
            <label for="calificacion">5. Calificación (1-10)</label>
          </div>
        </div>
        <button type="submit" class="btn waves-effect waves-light btn-vintage">Registrar en Catálogo</button>
      </form>
    </div>

    <!-- Tabla del Catálogo Registrado -->
    <div class="vintage-card" style="margin-top: 30px;">
      <h4>Catálogo Completo</h4>
      <table class="vintage-table responsive-table">
        <thead>
          <tr>
            <th>Título</th>
            <th>Tipo</th>
            <th>Género</th>
            <th>Año</th>
            <th>Calificación</th>
          </tr>
        </thead>
        <tbody>
          <% movies.forEach(m => { %>
            <tr>
              <td><strong><%= m.titulo %></strong></td>
              <td><span class="badge-gold"><%= m.tipo %></span></td>
              <td><%= m.genero %></td>
              <td><%= m.anio %></td>
              <td>⭐ <%= m.calificacion %> / 10</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>